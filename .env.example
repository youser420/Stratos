# Copy to .env (or .env.local) and fill in real values.

# Postgres connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/stratos_dev"

# Better Auth
BETTER_AUTH_SECRET="generate-a-random-32+-character-secret"
BETTER_AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. Powers Coach's conversational replies in the STRATOS Sphere
# (src/server/services/coach). Without it, Coach degrades to a neutral
# "not connected yet" state instead of failing — see section 14/16 of
# docs/implementation/STRATOS_LANDING_PAGE_ARCHITECTURE.md.
ANTHROPIC_API_KEY=""
